# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
# Application (client) ID from the Discord developer portal
CLIENT_ID=
# Guild (server) the slash commands are registered in
GUILD_ID=

# ---------------------------------------------------------------------------
# Claude
# ---------------------------------------------------------------------------
# How the bot reaches Claude:
#   aws        Claude Platform on AWS (default). Anthropic's Claude API, signed with the
#              same AWS credentials as Transcribe and Polly, and billed on your AWS bill.
#   anthropic  The Claude API directly, with ANTHROPIC_API_KEY.
CLAUDE_PROVIDER=aws
# Claude Platform on AWS workspace ID (starts with wrkspc_). Find it in the AWS Console
# under Claude Platform on AWS -> Workspaces.
ANTHROPIC_AWS_WORKSPACE_ID=
# The region the workspace was created in, if that isn't AWS_REGION (workspaces are
# bound to one region).
# CLAUDE_AWS_REGION=us-east-1
# Only for CLAUDE_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=
# Model for /chat (text) replies, and for spoken replies in voice channels.
CLAUDE_CHAT_MODEL=claude-opus-5-5
CLAUDE_VOICE_MODEL=claude-haiku-5-5
# How much the model thinks before answering: low | medium | high | xhigh | max.
# Lower is faster and cheaper; voice defaults to low to keep spoken replies quick.
CLAUDE_CHAT_EFFORT=medium
CLAUDE_VOICE_EFFORT=low
# Let Claude search the web (billed at $10 per 1,000 searches plus tokens).
WEB_SEARCH_ENABLED=true

# ---------------------------------------------------------------------------
# AWS (Transcribe for speech-to-text, Polly for text-to-speech, and Claude
# Platform on AWS). Credentials come from the standard AWS chain:
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, AWS_PROFILE, SSO, or an instance role.
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
TRANSCRIBE_LANGUAGE_CODE=en-US
POLLY_VOICE_ID=Kenneth
# standard | neural | long-form | generative (not every voice/region supports every engine)
POLLY_ENGINE=generative

# ---------------------------------------------------------------------------
# Music
# ---------------------------------------------------------------------------
# false turns music off: the music commands, and Nimbus when asked, say music is turned off.
MUSIC_ENABLED=true
# Who fetches the audio from YouTube: direct (this bot, with yt-dlp) or helpers (a music
# helper on someone's own computer; for the bot on AWS, where the CDK stack sets it up
# along with MUSIC_HELPER_API_URL and MUSIC_RELAY_BUCKET). See helper/README.md.
MUSIC_SOURCE=direct
# yt-dlp fetches YouTube audio. Leave unset to use the one on your PATH.
# YT_DLP_PATH=/usr/local/bin/yt-dlp
# Where /musichelper sends people for the helper and its instructions.
# MUSIC_HELPER_GUIDE_URL=https://github.com/ChaseFranz/discord-bot/tree/main/helper#readme

# ---------------------------------------------------------------------------
# Assistant behaviour
# ---------------------------------------------------------------------------
# Name the assistant answers to. The wake word defaults to the same name.
ASSISTANT_NAME=Nimbus
# WAKE_WORD=nimbus
# Play a short chime as soon as Nimbus hears its name (while you're still talking), so people know it's listening.
WAKE_SOUND_ENABLED=true
# Seconds after a spoken reply during which people can carry on without saying the
# wake word. 0 always requires the wake word.
FOLLOW_UP_SECONDS=8
# Who can carry on like that: everyone in the call, only the askers it just answered, or
# always (every line is put to Claude at any time; costs more, and it may join in more).
VOICE_FOLLOW_UPS=everyone
# Milliseconds of quiet before what someone said counts as finished. Lower is faster.
VOICE_SILENCE_MS=600
# Whose voice pauses Nimbus mid-reply: the askers it's answering, everyone, or off.
VOICE_BARGE_IN=askers
# How much they must say (milliseconds) before it pauses; shorter sounds are ignored.
VOICE_BARGE_IN_MS=500
# Say "one sec" to someone who asks while a reply to someone else is playing.
VOICE_ACKNOWLEDGE=true
# Keep what each person asked in a call, and the reply, in their own typed thread too.
VOICE_SAVE_TO_THREADS=true
# Leave a voice channel after this many minutes with nobody else in it. 0 stays.
AUTO_LEAVE_MINUTES=2
# Time zone for the current time, reminders, and when the daily budget resets (IANA
# name). Defaults to this computer's time zone.
# TIMEZONE=America/New_York

# ---------------------------------------------------------------------------
# Spending
# ---------------------------------------------------------------------------
# Daily cap per server, in USD, on estimated spending (Claude, web search, Transcribe,
# Polly). When it's reached, Nimbus stops listening and answering until midnight.
# 0 tracks spending (see /usage) without a cap.
DAILY_BUDGET_USD=5
# Built-in prices are us-east-1 list prices. Override them if yours differ.
# TRANSCRIBE_USD_PER_MINUTE=0.01
# POLLY_USD_PER_MILLION_CHARACTERS=30

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Where data is kept: sqlite (files on this computer) or dynamodb (the AWS tables; the
# CDK stack sets this on AWS). Each keeps its own data: switching doesn't copy anything.
STORAGE=sqlite
# For STORAGE=dynamodb. DYNAMODB_ENDPOINT is only for DynamoDB Local while testing
# (e.g. http://localhost:8000).
# DYNAMODB_TABLE=nimbus
# DYNAMODB_MEMORY_TABLE=nimbus-memories
# DYNAMODB_ENDPOINT=
# SQLite file holding conversations, voice transcripts and call recaps, settings,
# reminders and usage totals.
DATABASE_PATH=./data/bot.db
# Long-term notes Nimbus keeps about people and the server (see /memories). They don't
# expire; people delete their own with /memories.
MEMORY_DATABASE_PATH=./data/memories.db
# Voice transcripts (with their recaps), archived conversation turns and finished
# reminders older than this are deleted. 0 keeps everything forever.
MEMORY_RETENTION_DAYS=30

# error | warn | info | debug
LOG_LEVEL=info
