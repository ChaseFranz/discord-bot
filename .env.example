# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
# Application (client) ID from the Discord developer portal
CLIENT_ID=
# Guild (server) the slash commands are registered in
GUILD_ID=

# ---------------------------------------------------------------------------
# Claude
# ---------------------------------------------------------------------------
# How the bot reaches Claude:
#   aws        Claude Platform on AWS (default). Anthropic's Claude API, signed with the
#              same AWS credentials as Transcribe and Polly, and billed on your AWS bill.
#   anthropic  The Claude API directly, with ANTHROPIC_API_KEY.
CLAUDE_PROVIDER=aws
# Claude Platform on AWS workspace ID (starts with wrkspc_). Find it in the AWS Console
# under Claude Platform on AWS -> Workspaces.
ANTHROPIC_AWS_WORKSPACE_ID=
# The region the workspace was created in, if that isn't AWS_REGION (workspaces are
# bound to one region).
# CLAUDE_AWS_REGION=us-east-1
# Only for CLAUDE_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=
# Model for /chat (text) replies, and for spoken replies in voice channels.
CLAUDE_CHAT_MODEL=claude-opus-5-5
CLAUDE_VOICE_MODEL=claude-haiku-5-5
# How much the model thinks before answering: low | medium | high | xhigh | max.
# Lower is faster and cheaper; voice defaults to low to keep spoken replies quick.
CLAUDE_CHAT_EFFORT=medium
CLAUDE_VOICE_EFFORT=low
# Let Claude search the web (billed at $10 per 1,000 searches plus tokens).
WEB_SEARCH_ENABLED=true

# ---------------------------------------------------------------------------
# AWS (Transcribe for speech-to-text, Polly for text-to-speech, and Claude
# Platform on AWS). Credentials come from the standard AWS chain:
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, AWS_PROFILE, SSO, or an instance role.
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
TRANSCRIBE_LANGUAGE_CODE=en-US
POLLY_VOICE_ID=Joanna
# standard | neural | long-form | generative (not every voice/region supports every engine)
POLLY_ENGINE=generative

# ---------------------------------------------------------------------------
# Assistant behaviour
# ---------------------------------------------------------------------------
# Name the assistant answers to. The wake word defaults to the same name.
ASSISTANT_NAME=Nimbus
# WAKE_WORD=nimbus
# Play a short chime when Nimbus hears its name, so people know it's thinking.
WAKE_SOUND_ENABLED=true
# Minutes of recent voice-channel conversation included with each spoken request.
# Anything older is still available to the assistant through its memory tools.
AMBIENT_CONTEXT_MINUTES=3
# Timezone used when telling the assistant the current time (IANA name).
# TIMEZONE=America/New_York

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# SQLite file holding conversations, voice transcripts and settings.
DATABASE_PATH=./data/bot.db
# Long-term notes Nimbus keeps about people and the server (see /memories). They don't
# expire; people delete their own with /memories.
MEMORY_DATABASE_PATH=./data/memories.db
# Voice transcripts and archived conversation turns older than this are deleted.
# 0 keeps everything forever.
MEMORY_RETENTION_DAYS=30

# error | warn | info | debug
LOG_LEVEL=info
