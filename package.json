{
  "name": "discord-bot",
  "version": "2.0.0",
  "description": "Nimbus: a Discord voice and text assistant powered by Claude, with ambient group memory and music playback.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "prebuild": "npm test",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "memory-mcp": "node dist/memory/stdio.js",
    "smoke": "node dist/scripts/smoke.js",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/aws-sdk": "^1.1.2",
    "@anthropic-ai/sdk": "^1.14.0",
    "@aws-sdk/client-polly": "^3.1178.0",
    "@aws-sdk/client-transcribe-streaming": "^3.1178.0",
    "@discordjs/opus": "^0.11.0",
    "@discordjs/voice": "^0.19.2",
    "@distube/ytdl-core": "^5.2.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "prism-media": "^1.3.5",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3"
  }
}
