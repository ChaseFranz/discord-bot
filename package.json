{
  "name": "discord-bot",
  "version": "2.0.0",
  "description": "Nimbus: a Discord voice and text assistant powered by Claude, with ambient group memory and music playback.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "prebuild": "npm test",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "memory-mcp": "node dist/memory/stdio.js",
    "smoke": "node dist/scripts/smoke.js",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js",
    "register-commands": "node dist/scripts/registerCommands.js",
    "aws:secrets": "node dist/scripts/awsSwitch.js secrets",
    "aws:on": "node dist/scripts/awsSwitch.js on",
    "aws:off": "node dist/scripts/awsSwitch.js off",
    "test:dynamodb": "DYNAMODB_ENDPOINT=http://localhost:8000 npm test"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/aws-sdk": "^1.1.2",
    "@anthropic-ai/sdk": "^1.14.0",
    "@aws-sdk/client-cloudformation": "^3.1178.0",
    "@aws-sdk/client-dynamodb": "^3.1178.0",
    "@aws-sdk/client-ecs": "^3.1178.0",
    "@aws-sdk/client-lambda": "^3.1178.0",
    "@aws-sdk/client-polly": "^3.1178.0",
    "@aws-sdk/client-scheduler": "^3.1178.0",
    "@aws-sdk/client-secrets-manager": "^3.1178.0",
    "@aws-sdk/client-sqs": "^3.1178.0",
    "@aws-sdk/client-transcribe-streaming": "^3.1178.0",
    "@aws-sdk/lib-dynamodb": "^3.1178.0",
    "@discordjs/opus": "^0.11.0",
    "@discordjs/voice": "^0.19.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "discord-api-types": "^0.38.60",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "prism-media": "^1.3.5",
    "stemmer": "^2.0.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3"
  }
}
